{
  "name": "openai-codex-enhance",
  "version": "0.1.0",
  "description": "OpenAI Codex web, image, and native macOS Computer Use tools for pi",
  "type": "module",
  "keywords": ["pi-package", "openai-codex", "web-search", "image-generation", "computer-use"],
  "license": "MIT",
  "files": ["index.ts", "src", "README.md", "docs", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "tsx --test test/*/*.test.ts",
    "typecheck": "tsc --noEmit",
